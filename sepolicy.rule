# A1-内存管理 [HyperOS4] - KernelSU/Android 17
# a1guard runs in u:r:ksu:s0 on this device.
allow ksu untrusted_app_30:dir search;
allow ksu untrusted_app_30:dir open;
allow ksu untrusted_app_30:dir read;
allow ksu untrusted_app_30:dir getattr;
allow ksu untrusted_app_30:file read;
allow ksu untrusted_app_30:file write;
allow ksu untrusted_app_30:file open;
allow ksu untrusted_app_30:file getattr;
